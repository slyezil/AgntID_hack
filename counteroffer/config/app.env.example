# APP-ONLY configuration. Blank values must be populated locally, never in chat.
APP_MODE=demo
APP_HOST=127.0.0.1
APP_PORT=8000
OWNER_HOST=127.0.0.1
OWNER_PORT=8001
PUBLIC_ORIGIN=http://127.0.0.1:8000
DEV_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
APPLICATION_DB_PATH=./var/application.db
# Bedrock API key auth uses the ignored config/bedrock.local.json file.
# An AWS_PROFILE can be used instead when AWS credentials are available locally.
AWS_PROFILE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=google.gemma-4-e2b
AGNTID_MCP_URL=http://127.0.0.1:8082/mcp
# These are application settings for the verified SDK access_token and the
# portal-selected agent ID. Do not fill them until the actual portal/OAuth flow
# and agent are confirmed. Runtime auth mode remains UNVERIFIED until then.
AGNTID_ACCESS_TOKEN=
AGNTID_AGENT_ID=
# These names are application settings, not claimed vendor SDK constructor fields.
AGNTID_RUNTIME_AUTH_MODE=UNVERIFIED
AGNTID_INGRESS_CREDENTIAL=
EXECUTION_CONTEXT_KEY=
SESSION_SIGNING_KEY=
ACTIVE_TURN_LIMIT=1
QUEUE_LIMIT=10
TURN_TIMEOUT_SECONDS=120
MODEL_CALL_LIMIT=4
TOOL_CALL_LIMIT=6
MAX_SUCCESSFUL_OR_UNCERTAIN_WRITES_PER_TURN=1
# No Shopify secrets, raw MCP credential or baseline bypass setting belongs here.
