# CONNECTOR-ONLY configuration. No frontend or model access.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LIVE_WRITES_ENABLED=false
SHOPIFY_DEVELOPMENT_STORE_CONFIRMED=false
EXPECTED_CURRENCY=INR
CONNECTOR_DB_PATH=/data/connector.db
MCP_BIND_HOST=0.0.0.0
MCP_PORT=8100
# 0.0.0.0 is inside a private container with NO published host port.
MCP_UPSTREAM_BEARER_TOKEN=
EXECUTION_CONTEXT_KEY=
ALLOWED_SKUS=BOX-S,BOX-M,TAPE-48,WRAP-1,LABEL-100
# The delegated 300-bps ceiling is configured in AgntID, not enforced here.
